bcftools query     -f '%CHROM\t%POS\t%REF\t%INFO/END\n'     B73D2.gvcf.gz | awk 'BEGIN{OFS="\t"}
{
    chrom=$1
    pos=$2
    ref=$3
    end=$4

    start=pos-1

    if (end != "." && end != "") {
        bed_end=end
    } else {
        bed_end=pos + length(ref) - 1
    }

    print chrom,start,bed_end
}' | bedtools sort -i - | bedtools merge -i - | awk '{sum += $3-$2} END{print "Callable sites:",sum}'
